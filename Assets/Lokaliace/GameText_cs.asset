  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 12094636032
    m_Localized: "P\u0159\xEDjemy"
    m_Metadata:
      m_Items: []
  - m_Id: 176675872501760
    m_Localized: "V\xFDdaje"
    m_Metadata:
      m_Items: []
  - m_Id: 176859956310016
    m_Localized: Dluh
    m_Metadata:
      m_Items: []
  - m_Id: 177202203127808
    m_Localized: "Spravedlnost a po\u0159\xE1dek"
    m_Metadata:
      m_Items: []
  - m_Id: 177615392403456
    m_Localized: "Zahrani\u010Dni politika"
    m_Metadata:
      m_Items: []
  - m_Id: 177823090143232
    m_Localized: "Socialn\xED a zdravotni"
    m_Metadata:
      m_Items: []
  - m_Id: 178055827877888
    m_Localized: Doprava
    m_Metadata:
      m_Items: []
  - m_Id: 178208429240320
    m_Localized: Obrana
    m_Metadata:
      m_Items: []
  - m_Id: 182571553976320
    m_Localized: "Zak\xE1zat Kryptomn\u011Bny"
    m_Metadata:
      m_Items: []
  - m_Id: 182760700309504
    m_Localized: "St\xE1tn\xED nabo\u017Eenstv\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 183106663280640
    m_Localized: Uvalit cla
    m_Metadata:
      m_Items: []
  - m_Id: 183570129678336
    m_Localized: Legalizovat drogy
    m_Metadata:
      m_Items: []
  - m_Id: 183757841559552
    m_Localized: "Vystavba vysokorychlostn\xEDch trat\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 183928579092480
    m_Localized: "Zakoupen\xED dron\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 184937124655104
    m_Localized: "V\xFDdaje:"
    m_Metadata:
      m_Items: []
  - m_Id: 185124530352128
    m_Localized: 'Cena:'
    m_Metadata:
      m_Items: []
  - m_Id: 185271414878208
    m_Localized: Potvrdit
    m_Metadata:
      m_Items: []
  - m_Id: 186908426563584
    m_Localized: "Hl\xE1vn\xED ideologie:"
    m_Metadata:
      m_Items: []
  - m_Id: 187105609183232
    m_Localized: "Politick\xE1 s\xEDla:"
    m_Metadata:
      m_Items: []
  - m_Id: 187217571934208
    m_Localized: "Po\u010Det k\u0159esel:"
    m_Metadata:
      m_Items: []
  - m_Id: 187574624645120
    m_Localized: "Posledni v\xFDsledek ve volb\xE1ch:"
    m_Metadata:
      m_Items: []
  - m_Id: 188926926974976
    m_Localized: "Vr\xE1tit se do menu"
    m_Metadata:
      m_Items: []
  - m_Id: 190041752006656
    m_Localized: "P\u0159\xEDjmy:"
    m_Metadata:
      m_Items: []
  - m_Id: 192327064678400
    m_Localized: "Da\u0148 z p\u0159\xEDjmu"
    m_Metadata:
      m_Items: []
  - m_Id: 192875818053632
    m_Localized: "Da\u0148 z p\u0159\xEDjmu je \u010D\xE1st v\xFDd\u011Blku, kterou
      lid\xE9 a firmy odv\xE1d\u011Bj\xED st\xE1tu. Vy\u0161\u0161\xED da\u0148 znamen\xE1
      m\xE9n\u011B pen\u011Bz pro poplatn\xEDky, ale v\xEDce p\u0159\xEDjm\u016F
      pro st\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 197093358497792
    m_Localized: Platy soudcu
    m_Metadata:
      m_Items: []
  - m_Id: 197413237092352
    m_Localized: "Soudci pot\u0159ebuji plat"
    m_Metadata:
      m_Items: []
  - m_Id: 198243373740032
    m_Localized: Cla
    m_Metadata:
      m_Items: []
  - m_Id: 198378229002240
    m_Localized: neco
    m_Metadata:
      m_Items: []
  - m_Id: 199177105502208
    m_Localized: "Investive do zdravotnictv\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 199518236635136
    m_Localized: "Investov\xE1ni do zdravotnictv\xED je velmi dule\u017Eit\xE9 a
      zlep\u0161uje to zdrav\xFD tv\xFDch lidi"
    m_Metadata:
      m_Items: []
  - m_Id: 200295395028992
    m_Localized: "Silni\u010Dni da\u0148"
    m_Metadata:
      m_Items: []
  - m_Id: 200470041653248
    m_Localized: "v\u017Eum"
    m_Metadata:
      m_Items: []
  - m_Id: 200874057986048
    m_Localized: "V\xFDdaje na arm\xE1du"
    m_Metadata:
      m_Items: []
  - m_Id: 201016496549888
    m_Localized: "Armada je pot\u0159eba k zaji\u0161teni bezpe\u010Dnosti"
    m_Metadata:
      m_Items: []
  - m_Id: 307975912615936
    m_Localized: "Delnick\xE1 st\xE1vka"
    m_Metadata:
      m_Items: []
  - m_Id: 308195522179072
    m_Localized: "Delnic\xED stavkuji cht\u011Bj\xED v\xEDc pen\u011Bz"
    m_Metadata:
      m_Items: []
  - m_Id: 308579439407104
    m_Localized: "Zv\xFD\u0161it platy"
    m_Metadata:
      m_Items: []
  - m_Id: 308827616374784
    m_Localized: "Potla\u010Dit st\xE1vku"
    m_Metadata:
      m_Items: []
  - m_Id: 19518500915572736
    m_Localized: "Chud\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 19518651503669248
    m_Localized: "St\u0159edn\xED t\u0159\xEDda"
    m_Metadata:
      m_Items: []
  - m_Id: 19518754566107136
    m_Localized: "Bohat\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 19518880470724608
    m_Localized: "Nacionalist\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 19519184482267136
    m_Localized: "Liber\xE1lov\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 19519357723799552
    m_Localized: Konzervativci
    m_Metadata:
      m_Items: []
  - m_Id: 19519430922792960
    m_Localized: "Kapitalist\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 19519515115057152
    m_Localized: "Socialist\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 19519624078880768
    m_Localized: "V\u011B\u0159\xEDc\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 19519819986432000
    m_Localized: "Environmentalist\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 24206223911874560
    m_Localized: "Mzdov\xE1 da\u0148"
    m_Metadata:
      m_Items: []
  - m_Id: 24210632389619712
    m_Localized: "Mzdov\xE1 da\u0148 je da\u0148 placen\xE1 z mezd zam\u011Bstnanc\u016F.
      Vy\u0161\u0161\xED mzdov\xE1 da\u0148 zvy\u0161uje n\xE1klady na zam\u011Bstn\xE1v\xE1n\xED
      pracovn\xEDk\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 24216089086849024
    m_Localized: "Da\u0148 z kapit\xE1lov\xFDch v\xFDnos\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 24216271971086336
    m_Localized: "Da\u0148 z kapit\xE1lov\xFDch v\xFDnos\u016F je da\u0148 z zisku
      z\xEDskan\xE9ho prodejem investic, jako jsou akcie nebo nemovitosti. Vy\u0161\u0161\xED
      da\u0148 sni\u017Euje zisk investor\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 24218456624656384
    m_Localized: "Korpor\xE1tn\xED da\u0148"
    m_Metadata:
      m_Items: []
  - m_Id: 24218660262309888
    m_Localized: "Korpor\xE1tn\xED da\u0148 je da\u0148, kterou firmy plat\xED ze
      sv\xE9ho zisku. Vy\u0161\u0161\xED korpor\xE1tn\xED da\u0148 sni\u017Euje zisky
      firem, ale zvy\u0161uje p\u0159\xEDjmy st\xE1tu."
    m_Metadata:
      m_Items: []
  - m_Id: 24220283277602816
    m_Localized: "Z\xE1kon o hospod\xE1\u0159sk\xE9 sout\u011B\u017Ei"
    m_Metadata:
      m_Items: []
  - m_Id: 24220515201642496
    m_Localized: "Z\xE1kon o hospod\xE1\u0159sk\xE9 sout\u011B\u017Ei stanovuje pravidla,
      kter\xE1 br\xE1n\xED firm\xE1m zneu\u017E\xEDvat sv\xE9 postaven\xED na trhu.
      Jeho c\xEDlem je udr\u017Eet f\xE9rovou konkurenci mezi podniky."
    m_Metadata:
      m_Items: []
  - m_Id: 24225392636129280
    m_Localized: "Omezen\xED zne\u010Di\u0161t\u011Bn\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 24225602779148288
    m_Localized: "Omezen\xED zne\u010Di\u0161t\u011Bn\xED jsou pravidla, kter\xE1
      stanovuj\xED, kolik \u0161kodlivin mohou firmy nebo lid\xE9 vypou\u0161t\u011Bt.
      P\u0159\xEDsn\u011Bj\u0161\xED pravidla sni\u017Euj\xED zne\u010Di\u0161t\u011Bn\xED,
      ale mohou zvy\u0161ovat n\xE1klady."
    m_Metadata:
      m_Items: []
  - m_Id: 24226889616781312
    m_Localized: "Da\u0148 z d\u011Bdictv\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 24227095435472896
    m_Localized: "D\u011Bdick\xE1 da\u0148 je poplatek, kter\xFD se plat\xED z majetku
      z\xEDskan\xE9ho po zem\u0159el\xE9m. Vy\u0161\u0161\xED da\u0148 znamen\xE1,
      \u017Ee si d\u011Bdic ponech\xE1 men\u0161\xED \u010D\xE1st majetku."
    m_Metadata:
      m_Items: []
  - m_Id: 24227214486597632
    m_Localized: "Z\xE1kon o bezpe\u010Dnosti pr\xE1ce"
    m_Metadata:
      m_Items: []
  - m_Id: 24228639308443648
    m_Localized: "Z\xE1kon o bezpe\u010Dnosti pr\xE1ce stanovuje pravidla, kter\xE1
      maj\xED chr\xE1nit zam\u011Bstnance p\u0159i pr\xE1ci. Poru\u0161en\xED t\u011Bchto
      pravidel m\u016F\u017Ee v\xE9st k pokut\xE1m nebo zastaven\xED provozu."
    m_Metadata:
      m_Items: []
  - m_Id: 24230188428488704
    m_Localized: "Pracovn\xED z\xE1kony"
    m_Metadata:
      m_Items: []
  - m_Id: 24230305235660800
    m_Localized: "Pracovn\xED z\xE1kony ur\u010Duj\xED z\xE1kladn\xED pravidla mezi
      zam\u011Bstnanci a zam\u011Bstnavateli, jako jsou pracovn\xED doba, mzda a
      podm\xEDnky pr\xE1ce. Pom\xE1haj\xED udr\u017Eet rovnov\xE1hu mezi ob\u011Bma
      stranami."
    m_Metadata:
      m_Items: []
  - m_Id: 24232565642555392
    m_Localized: Recyklace
    m_Metadata:
      m_Items: []
  - m_Id: 24232775588442112
    m_Localized: "Podpora recyklace znamen\xE1 opat\u0159en\xED, kter\xE1 motivuj\xED
      lidi a firmy v\xEDce t\u0159\xEDdit a znovu vyu\u017E\xEDvat odpad. Vy\u0161\u0161\xED
      podpora obvykle sni\u017Euje mno\u017Estv\xED odpadu."
    m_Metadata:
      m_Items: []
  - m_Id: 24260600139804672
    m_Localized: "V\u011Bznice"
    m_Metadata:
      m_Items: []
  - m_Id: 24260913676611584
    m_Localized: "Investice do v\u011Bznic znamen\xE1 pen\xEDze na stavbu, roz\u0161\xED\u0159en\xED
      nebo zlep\u0161en\xED v\u011Bze\u0148sk\xFDch za\u0159\xEDzen\xED. Vy\u0161\u0161\xED
      investice zlep\u0161uj\xED kapacitu a podm\xEDnky ve v\u011Bznic\xEDch."
    m_Metadata:
      m_Items: []
  - m_Id: 24262079743455232
    m_Localized: "Policejn\xED jednotky"
    m_Metadata:
      m_Items: []
  - m_Id: 24262483675901952
    m_Localized: "Rozpo\u010Det pro policii je mno\u017Estv\xED pen\u011Bz, kter\xE9
      st\xE1t d\xE1v\xE1 policii na jej\xED fungov\xE1n\xED. Vy\u0161\u0161\xED rozpo\u010Det
      m\u016F\u017Ee znamenat v\xEDce policist\u016F a lep\u0161\xED vybaven\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 24263626384666624
    m_Localized: "Z\xE1kon proti rasov\xE9 diskriminaci"
    m_Metadata:
      m_Items: []
  - m_Id: 24264021853007872
    m_Localized: "Z\xE1kon proti rasov\xE9 diskriminaci zakazuje, aby byli lid\xE9
      znev\xFDhod\u0148ov\xE1ni kv\u016Fli sv\xE9 rase nebo p\u016Fvodu. Poru\u0161en\xED
      tohoto z\xE1kona m\u016F\u017Ee v\xE9st k pokut\xE1m nebo jin\xFDm trest\u016Fm."
    m_Metadata:
      m_Items: []
  - m_Id: 24265391133880320
    m_Localized: "Ob\u010Densk\xFD pr\u016Fkaz"
    m_Metadata:
      m_Items: []
  - m_Id: 24265552354537472
    m_Localized: "Ob\u010Dansk\xE9 pr\u016Fkazy jsou doklady toto\u017Enosti, kter\xE9
      pom\xE1haj\xED st\xE1t\u016Fm evidovat a identifikovat obyvatele. Mohou zjednodu\u0161it
      kontrolu identity p\u0159i bezpe\u010Dnostn\xEDch situac\xEDch."
    m_Metadata:
      m_Items: []
  - m_Id: 24266553069334528
    m_Localized: "Genderov\xE1 tranzice"
    m_Metadata:
      m_Items: []
  - m_Id: 24266721533554688
    m_Localized: "Genderov\xE1 tranzice je proces, kdy \u010Dlov\u011Bk m\u011Bn\xED
      sv\u016Fj vzhled, jm\xE9no nebo zp\u016Fsob \u017Eivota tak, aby v\xEDc odpov\xEDdal
      tomu, k\xFDm se c\xEDt\xED b\xFDt. M\u016F\u017Ee zahrnovat soci\xE1ln\xED
      i l\xE9ka\u0159sk\xE9 kroky."
    m_Metadata:
      m_Items: []
  - m_Id: 24267930768175104
    m_Localized: "Zpravodajsk\xE9 slu\u017Eby"
    m_Metadata:
      m_Items: []
  - m_Id: 24268131713085440
    m_Localized: "Zpravodajsk\xE9 slu\u017Eby jsou st\xE1tn\xED organizace, kter\xE9
      sb\xEDraj\xED informace o hrozb\xE1ch pro bezpe\u010Dnost st\xE1tu. Pom\xE1haj\xED
      vl\xE1d\u011B p\u0159edch\xE1zet nebezpe\u010Dn\xFDm situac\xEDm."
    m_Metadata:
      m_Items: []
  - m_Id: 24269472309112832
    m_Localized: "Pr\xE1vo na soukrom\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 24269839289741312
    m_Localized: "Pr\xE1vo na soukrom\xED znamen\xE1, \u017Ee lid\xE9 maj\xED kontrolu
      nad sv\xFDmi osobn\xEDmi informacemi a t\xEDm, kdo je m\u016F\u017Ee vid\u011Bt
      nebo pou\u017E\xEDvat. St\xE1t i firmy mus\xED respektovat soukrom\xED ob\u010Dan\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 24461115742154752
    m_Localized: Regulace drog
    m_Metadata:
      m_Items: []
  - m_Id: 24461524368027648
    m_Localized: "Regulace drog ur\u010Duje, kter\xE9 drogy jsou leg\xE1ln\xED, omezen\xE9
      nebo zak\xE1zan\xE9. P\u0159\xEDsn\u011Bj\u0161\xED regulace obvykle znamen\xE1
      p\u0159\xEDsn\u011Bj\u0161\xED kontrolu jejich v\xFDroby, prodeje a u\u017E\xEDv\xE1n\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 24463682656202752
    m_Localized: "Pokuty za poru\u0161en\xED z\xE1kona"
    m_Metadata:
      m_Items: []
  - m_Id: 24463899078094848
    m_Localized: "Pokuty za poru\u0161en\xED z\xE1kona jsou finan\u010Dn\xED tresty
      ud\u011Blovan\xE9 za nez\xE1konn\xE9 jedn\xE1n\xED. Vy\u0161\u0161\xED pokuty
      mohou odradit lidi od poru\u0161ov\xE1n\xED pravidel."
    m_Metadata:
      m_Items: []
  - m_Id: 25564649774575616
    m_Localized: "Hrani\u010Dn\xED kontroly"
    m_Metadata:
      m_Items: []
  - m_Id: 25564887264456704
    m_Localized: "Hrani\u010Dn\xED kontroly jsou opat\u0159en\xED, kter\xE1 sleduj\xED
      pohyb lid\xED a zbo\u017E\xED p\u0159es st\xE1tn\xED hranice. P\u0159\xEDsn\u011Bj\u0161\xED
      kontroly mohou zv\xFD\u0161it bezpe\u010Dnost, ale zpomalit cestov\xE1n\xED
      a obchod."
    m_Metadata:
      m_Items: []
  - m_Id: 25565961769644032
    m_Localized: "Zahrani\u010Dn\xED pomoc"
    m_Metadata:
      m_Items: []
  - m_Id: 25566243073224704
    m_Localized: "Zahrani\u010Dn\xED pomoc jsou pen\xEDze, vybaven\xED nebo slu\u017Eby,
      kter\xE9 st\xE1t poskytuje jin\xFDm zem\xEDm. M\u016F\u017Ee zlep\u0161ovat
      vztahy mezi st\xE1ty a pom\xE1hat p\u0159i kriz\xEDch."
    m_Metadata:
      m_Items: []
  - m_Id: 25568240509841408
    m_Localized: "Turistick\xE1 da\u0148"
    m_Metadata:
      m_Items: []
  - m_Id: 25568483322294272
    m_Localized: "Turistick\xE1 da\u0148 je poplatek, kter\xFD plat\xED n\xE1v\u0161t\u011Bvn\xEDci
      p\u0159i pobytu v dan\xE9 zemi nebo oblasti. Vy\u0161\u0161\xED da\u0148 zvy\u0161uje
      p\u0159\xEDjmy st\xE1tu, ale m\u016F\u017Ee odradit n\u011Bkter\xE9 turisty."
    m_Metadata:
      m_Items: []
  - m_Id: 25574595509547008
    m_Localized: "Exportn\xED dotace"
    m_Metadata:
      m_Items: []
  - m_Id: 25576789117956096
    m_Localized: "Exportn\xED dotace jsou finan\u010Dn\xED podpory pro firmy, kter\xE9
      prod\xE1vaj\xED sv\xE9 v\xFDrobky do zahrani\u010D\xED. Pom\xE1haj\xED zv\xFD\u0161it
      konkurenceschopnost dom\xE1c\xEDch podnik\u016F na sv\u011Btov\xFDch trz\xEDch."
    m_Metadata:
      m_Items: []
  - m_Id: 25576914846412800
    m_Localized: "Zdravotn\xED poji\u0161t\u011Bn\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 25578208726282240
    m_Localized: "Da\u0148 na zdravotn\xED poji\u0161t\u011Bn\xED je povinn\xFD p\u0159\xEDsp\u011Bvek,
      kter\xFD pom\xE1h\xE1 financovat zdravotn\xED p\xE9\u010Di. Vy\u0161\u0161\xED
      da\u0148 zvy\u0161uje p\u0159\xEDjmy zdravotn\xEDho syst\xE9mu, ale sni\u017Euje
      p\u0159\xEDjem poplatn\xEDk\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 25578428981768192
    m_Localized: "Rozpo\u010Det nemocnic"
    m_Metadata:
      m_Items: []
  - m_Id: 25579528908632064
    m_Localized: "Rozpo\u010Det nemocnic ur\u010Duje, kolik pen\u011Bz je k dispozici
      na provoz a vybaven\xED nemocnic. Vy\u0161\u0161\xED rozpo\u010Det m\u016F\u017Ee
      zlep\u0161it kvalitu a dostupnost zdravotn\xED p\xE9\u010De."
    m_Metadata:
      m_Items: []
  - m_Id: 25580655381245952
    m_Localized: "Penzijn\xED rozpo\u010Det"
    m_Metadata:
      m_Items: []
  - m_Id: 25580727015763968
    m_Localized: "Rozpo\u010Det na d\u016Fchody ur\u010Duje, kolik pen\u011Bz st\xE1t
      vy\u010Dlen\xED na vypl\xE1cen\xED d\u016Fchod\u016F. Vy\u0161\u0161\xED rozpo\u010Det
      m\u016F\u017Ee znamenat vy\u0161\u0161\xED d\u016Fchody pro seniory."
    m_Metadata:
      m_Items: []
  - m_Id: 25582450648215552
    m_Localized: "Podpora p\xE9\u010De o d\u011Bti"
    m_Metadata:
      m_Items: []
  - m_Id: 25582568529129472
    m_Localized: "Podpora p\xE9\u010De o d\u011Bti zahrnuje finan\u010Dn\xED pomoc
      a slu\u017Eby pro rodiny s d\u011Btmi. Vy\u0161\u0161\xED podpora m\u016F\u017Ee
      rodi\u010D\u016Fm usnadnit p\xE9\u010Di o d\u011Bti a n\xE1vrat do pr\xE1ce."
    m_Metadata:
      m_Items: []
  - m_Id: 25583416613203968
    m_Localized: "Soci\xE1ln\xED d\xE1vky"
    m_Metadata:
      m_Items: []
  - m_Id: 25583556434522112
    m_Localized: "Soci\xE1ln\xED rozpo\u010Det ur\u010Duje, kolik pen\u011Bz st\xE1t
      vynalo\u017E\xED na d\xE1vky a pomoc lidem v obt\xED\u017En\xE9 situaci. Vy\u0161\u0161\xED
      rozpo\u010Det znamen\xE1 v\u011Bt\u0161\xED podporu pro pot\u0159ebn\xE9 ob\u010Dany."
    m_Metadata:
      m_Items: []
  - m_Id: 25652815445553152
    m_Localized: "Programy du\u0161evn\xEDho zdrav\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 25653251334402048
    m_Localized: "Programy du\u0161evn\xEDho zdrav\xED poskytuj\xED podporu lidem
      s psychick\xFDmi probl\xE9my a pom\xE1haj\xED p\u0159edch\xE1zet jejich vzniku.
      Vy\u0161\u0161\xED podpora zlep\u0161uje dostupnost p\xE9\u010De a prevence."
    m_Metadata:
      m_Items: []
  - m_Id: 25654296546570240
    m_Localized: "Da\u0148 z ne\u0159est\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 25654479158177792
    m_Localized: "Da\u0148 z ne\u0159est\xED je zvl\xE1\u0161tn\xED da\u0148 na v\xFDrobky,
      jako jsou cigarety, alkohol nebo hazard. Vy\u0161\u0161\xED da\u0148 zdra\u017Euje
      tyto produkty a zvy\u0161uje p\u0159\xEDjmy st\xE1tu."
    m_Metadata:
      m_Items: []
  - m_Id: 25656990296371200
    m_Localized: "St\xE1tn\xED \u0161koly"
    m_Metadata:
      m_Items: []
  - m_Id: 25657123012538368
    m_Localized: "St\xE1tn\xED \u0161koly jsou \u0161koly financovan\xE9 a spravovan\xE9
      st\xE1tem. Jsou dostupn\xE9 v\u0161em ob\u010Dan\u016Fm bez p\u0159\xEDm\xE9ho
      placen\xED \u0161koln\xE9ho."
    m_Metadata:
      m_Items: []
  - m_Id: 25658301913952256
    m_Localized: "Financov\xE1n\xED v\u011Bdy"
    m_Metadata:
      m_Items: []
  - m_Id: 25658494273122304
    m_Localized: "Financov\xE1n\xED v\u011Bdy ur\u010Duje, kolik pen\u011Bz st\xE1t
      investuje do v\xFDzkumu a v\xFDvoje. Vy\u0161\u0161\xED financov\xE1n\xED m\u016F\u017Ee
      v\xE9st k nov\xFDm objev\u016Fm a technologick\xE9mu pokroku."
    m_Metadata:
      m_Items: []
  - m_Id: 25659322589442048
    m_Localized: "Dotace na um\u011Bn\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 25659598251683840
    m_Localized: "Dotace na um\u011Bn\xED jsou finan\u010Dn\xED p\u0159\xEDsp\u011Bvky
      pro um\u011Blce a kulturn\xED projekty. Pom\xE1haj\xED vytv\xE1\u0159et a zachov\xE1vat
      kulturn\xED tvorbu."
    m_Metadata:
      m_Items: []
  - m_Id: 26067368067133440
    m_Localized: "Po\u010Det kol"
    m_Metadata:
      m_Items: []
  - m_Id: 26422026086313984
    m_Localized: "V\xEDt\u011Bzstv\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 26422233125548032
    m_Localized: Prohra
    m_Metadata:
      m_Items: []
  - m_Id: 26422450382106624
    m_Localized: "Pokra\u010Dovat"
    m_Metadata:
      m_Items: []
  - m_Id: 26423465391091712
    m_Localized: Quit
    m_Metadata:
      m_Items: []
  - m_Id: 26427659766394880
    m_Localized: "Detail st\xE1tu"
    m_Metadata:
      m_Items: []
  - m_Id: 26428229793280000
    m_Localized: "Politick\xE9 napady"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
