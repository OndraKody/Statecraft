  - m_Id: 200874057986048
    m_Localized: Military spending
    m_Metadata:
      m_Items: []
  - m_Id: 201016496549888
    m_Localized: The army is needed to ensure security.
    m_Metadata:
      m_Items: []
  - m_Id: 307975912615936
